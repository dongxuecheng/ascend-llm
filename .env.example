# Shared runtime
VLLM_IMAGE=quay.io/ascend/vllm-ascend:v0.23.0-310p-openeuler

# Model paths
QWEN35_MODEL_DIR=/data/models/Qwen3.6-35B-A3B-w8a8
QWEN27_MODEL_DIR=/data/models/Qwen3.6-27B-W8A8-310P
QWEN38_MODEL_DIR=/data/models/Qwen3.8-27B-w8a8

# OpenAI-compatible served model names
QWEN35_MODEL_NAME=qwen3.6-35b-a3b
QWEN27_MODEL_NAME=qwen3.6-27b
QWEN38_MODEL_NAME=qwen3.8-27b

# Keep the same limits for a fair A/B test.
QWEN35_MAX_MODEL_LEN=20480
QWEN27_MAX_MODEL_LEN=20480
QWEN38_MAX_MODEL_LEN=20480
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.90
