# Docker Compose project
COMPOSE_PROJECT_NAME=ascend-llm

# Images and model
VLLM_IMAGE=quay.io/ascend/vllm-ascend:v0.23.0-310p-openeuler
NGINX_IMAGE=nginx:1.28-alpine
MODEL_DIR=/data/models/Qwen3.6-35B-A3B-w8a8
MODEL_NAME=qwen3.6

# Persistent host directories
LOG_ROOT=/data/logs
CACHE_ROOT=/data/cache

# Physical Atlas 300I Duo PCIe functions confirmed on hz-server
BDF_A=0000:01:00.0
BDF_B=0000:03:00.0

# Leave empty to let scripts/deploy.sh derive the CPU list from PCIe NUMA.
# Explicit examples: 0-31 or 0,2,4,6.
CPUSET_A=
CPUSET_B=

# Conservative Atlas 300I Duo settings. Two replicas provide aggregate
# max_num_seqs=16 while each instance only captures graph sizes [1,8].
MAX_MODEL_LEN=20480
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.90

# The gateway stays local by default. Put an authenticated TLS reverse proxy
# in front before changing this to 0.0.0.0:8000.
GATEWAY_LISTEN=127.0.0.1:8000

# Do not start the second 38 GB model instance unless this much host memory is
# still available after the first instance becomes healthy.
MIN_MEM_FOR_SECOND_GIB=48
